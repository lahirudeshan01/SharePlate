# Environment
NODE_ENV=development

# Server
PORT=5000

# MongoDB
# For local development: mongodb://localhost:27017/shareplate
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/shareplate?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/shareplate

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email Service (Optional - for future use)
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@shareplate.com

# SMS Service (Optional - for future use)
SMS_API_KEY=your-sms-api-key
SMS_ACCOUNT_SID=your-sms-account-sid
